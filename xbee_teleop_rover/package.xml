<?xml version="1.0"?>
<package format="3">
  <name>xbee_teleop</name>
  <version>0.2.0</version>
  <description>Gamepad teleop over XBee (DigiMesh, API mode) with a PyQt5 status GUI</description>
  <maintainer email="you@example.com">your_name</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
